#!/usr/bin/env python3
"""Permit one exact migration-branch creation or direct-child correction."""

import os
from pathlib import Path
import re
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))
import repository


try:
    hook = Path(__file__)
    relative = ".github/migration-hooks/pre-push"
    expected = repository.entries(repository.run(
        "git", "ls-tree", "-z", "HEAD", "--", relative
    )).get(relative)
    if hook.is_symlink() or not hook.is_file() or not os.access(hook, os.X_OK) \
            or expected is None or expected[0] != "100755" \
            or repository.actual_blob(hook) != expected:
        raise ValueError("Migration guard must match its committed executable blob")
    sha = os.environ["MIGRATION_SHA"]
    old = os.environ.get("MIGRATION_OLD_SHA", "0" * 40)
    ref = os.environ["MIGRATION_REF"]
    if not all(re.fullmatch(r"[0-9a-f]{40}", value) for value in (sha, old)) or ref != \
            "refs/heads/miyako-simplify-pngcrush-workflows":
        raise ValueError("Unexpected migration SHA/ref")
    repository.verify_checkout(sha)
    if old != "0" * 40 and repository.run(
        "git", "rev-list", "--parents", "-n", "1", sha
    ) != f"{sha} {old}":
        raise ValueError("Migration correction must be the exact old SHA's single direct child")
    advertisement = sys.stdin.read()
    if advertisement.splitlines() not in (
        [f"{sha} {sha} {ref} {old}"],
        [f"HEAD {sha} {ref} {old}"],
    ):
        raise ValueError("Expected exactly one literal old/new migration branch advertisement")
    message = repository.run("git", "log", "-1", "--format=%B", sha).rstrip()
    if not message.endswith(
        "Co-authored-by: Copilot App <223556219+Copilot@users.noreply.github.com>"
    ):
        raise ValueError("Migration commit requires literal ending co-author trailer")
    if os.environ.get("MIGRATION_ADVERTISEMENT_LOG"):
        with open(os.environ["MIGRATION_ADVERTISEMENT_LOG"], "x", encoding="ascii") as output:
            output.write(advertisement)
except (KeyError, ValueError, OSError) as error:
    sys.exit(f"Migration push stopped: {error}")
